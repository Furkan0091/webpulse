# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://webpulse:webpulse@localhost:5432/webpulse?schema=public

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Web ───────────────────────────────────────────────────
# Public base URL used in emails, status page links, webhook signatures
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────
# Resend (https://resend.com) is preferred when RESEND_API_KEY is set;
# it takes priority over SMTP. Verify a domain or use onboarding@resend.dev
# to send to your own address during testing.
RESEND_API_KEY=
RESEND_FROM=WebPulse <onboarding@resend.dev>

# SMTP fallback (used only if RESEND_API_KEY is empty).
# Leave SMTP_HOST empty to log emails instead of sending (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WebPulse <alerts@webpulse.local>
SMTP_SECURE=false

# ── Monitoring engine ─────────────────────────────────────
MONITORING_REGION=us-east-1
MONITOR_WORKER_CONCURRENCY=10
# How often (ms) the scheduler scans for due monitors
SCHEDULER_INTERVAL_MS=5000
# Retention (days) for raw check results
RETENTION_RAW_CHECKS_DAYS=30
