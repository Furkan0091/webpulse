# Vite environment variables (web/)
#
# Only needed when the frontend is served from a different origin than the API
# (i.e. production). Leave unset in local dev to use the Vite proxy at /api.

# Absolute base URL of the WebPulse backend API. Include the /api suffix,
# e.g. https://webpulse-api-547h.onrender.com/api (the frontend appends paths
# like /auth/login and /orgs to this base).
VITE_API_URL=
